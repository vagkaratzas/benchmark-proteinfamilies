/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PRE smoke test that exercises the DOWNLOAD_* modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run . -profile test_pre_download,conda --outdir /tmp/pre_download_test

    Every *_db is left null, so each DOWNLOAD_* module runs for real -- curl, tar, gunzip,
    split_pfam_seed.py and the non-empty assertions all execute. The links are `file://`
    URLs pointing at committed archive fixtures shaped like the real ones, so the run stays
    offline and fast while still covering the code that -profile test_pre skips.

    curl speaks the FILE protocol, so the only difference from a production run is the
    scheme in the URL.
----------------------------------------------------------------------------------------
*/

process {
    cpus   = 1
    memory = 2.GB
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]

    // Same fixture artefact as -profile test_pre: the toy sequences spell DNA and DIAMOND
    // rejects them unless warnings are ignored.
    withName: 'DIAMOND_MAKEDB|DIAMOND_BLASTP' {
        ext.args = '--ignore-warnings'
    }
}

params {
    workflow_mode = 'pre'

    // interpro_*_db left null: DOWNLOAD_INTERPRO fetches both files from these links.
    interpro_hierarchy_latest_link = "file://${projectDir}/assets/fixtures/pre/ParentChildTreeFile.txt"
    interpro_mapping_latest_link   = "file://${projectDir}/assets/fixtures/pre/interpro.xml.gz"

    hamap_latest_link     = "file://${projectDir}/assets/fixtures/downloads/hamap_alignments.tar.gz"
    ncbifam_latest_link   = "file://${projectDir}/assets/fixtures/downloads/hmm_PGAP.SEED.tgz"
    panther_latest_link   = "file://${projectDir}/assets/fixtures/downloads/PANTHER19.0_fasta.tgz"
    pfam_latest_link      = "file://${projectDir}/assets/fixtures/downloads/Pfam-A.seed.gz"
    swissprot_latest_link = "file://${projectDir}/assets/fixtures/downloads/uniprot_sprot.fasta.gz"

    // As in test_pre: the fixture families are tiny, so the production floor of 25 would
    // filter every candidate away.
    min_membership = 1
    num_per_db     = 1
    num_decoys     = 2
    seed           = 1
}
