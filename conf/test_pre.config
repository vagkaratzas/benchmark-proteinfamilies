/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Fast, offline PRE smoke test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run . -profile test_pre,conda --outdir /tmp/pre_test

    Every *_db points at a committed fixture, so no DOWNLOAD_* process runs and the whole
    PRE path executes in seconds with no network. The download modules themselves are
    covered by -profile test_pre_download.
----------------------------------------------------------------------------------------
*/

process {
    cpus   = 1
    memory = 2.GB
    // A bare `memory` is only a default: `withLabel:process_medium` in conf/base.config still
    // asks for 36.GB and would not schedule on a laptop. resourceLimits caps every request
    // instead, so the production resource tiers stay untouched.
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]

    // The fixture "proteins" are 4-residue strings like AAAA/CCCC, so DIAMOND sees a database
    // that contains only DNA letters and refuses it as a mis-supplied nucleotide FASTA. Real
    // member databases never trip this, so the override belongs to the fixtures, not the pipeline.
    withName: 'DIAMOND_MAKEDB|DIAMOND_BLASTP' {
        ext.args = '--ignore-warnings'
    }
}

params {
    workflow_mode = 'pre'

    interpro_hierarchy_db = "${projectDir}/assets/fixtures/pre/ParentChildTreeFile.txt"
    interpro_mapping_db   = "${projectDir}/assets/fixtures/pre/interpro.xml.gz"
    hamap_db              = "${projectDir}/assets/fixtures/db_metadata/hamap"
    ncbifam_db            = "${projectDir}/assets/fixtures/db_metadata/ncbifam"
    panther_db            = "${projectDir}/assets/fixtures/db_metadata/panther"
    pfam_db               = "${projectDir}/assets/fixtures/db_metadata/pfam"
    swissprot_db          = "${projectDir}/assets/fixtures/pre/swissprot.fasta"

    // The fixture families hold two sequences each, so the production floor of 25 would
    // filter every candidate away and leave the run with nothing to sample.
    min_membership = 1
    num_per_db     = 1
    num_decoys     = 2
    seed           = 1
}
