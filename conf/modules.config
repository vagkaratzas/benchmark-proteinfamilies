/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // pre
    withName: 'REMOVE_DUPLICATE_BRANCHES' {
        publishDir = [
            path: { "${params.outdir}/pre/interpro" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_VALID_INTERPRO_IDS' {
        publishDir = [
            path: { "${params.outdir}/pre/interpro" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_CANDIDATE_INTERPRO_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/pre/interpro" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_DB_METADATA' {
        publishDir = [
            path: { "${params.outdir}/pre/families/num_proteins" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_VALID_CANDIDATE_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/pre/interpro" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMPLE_INTERPRO' {
        publishDir = [
            path: { "${params.outdir}/pre/interpro" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PREPARE_BENCHMARK_FASTA' {
        publishDir = [
            path: { "${params.outdir}/pre/families/sampled" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DIAMOND_MAKEDB' {
        publishDir = [
            path: { "${params.outdir}/pre/diamond" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DIAMOND_BLASTP' {
        publishDir = [
            path: { "${params.outdir}/pre/diamond" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IDENTIFY_UNIPROT_DECOYS' {
        publishDir = [
            path: { "${params.outdir}/pre/decoys" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMBINE_DECOY_FASTA' {
        publishDir = [
            path: { "${params.outdir}/pre" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DOWNLOAD_INTERPRO' {
        publishDir = [enabled: false]
    }

    withName: 'DOWNLOAD_HAMAP' {
        publishDir = [enabled: false]
    }

    withName: 'DOWNLOAD_NCBIFAM' {
        publishDir = [enabled: false]
    }

    withName: 'DOWNLOAD_PANTHER' {
        publishDir = [enabled: false]
    }

    withName: 'DOWNLOAD_PFAM' {
        publishDir = [enabled: false]
    }

    withName: 'DOWNLOAD_SWISSPROT' {
        publishDir = [enabled: false]
    }

    // post
    withName: 'CALCULATE_SEQUENCE_STATS' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/sequence_coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_DB_SEQUENCE_COVERAGE' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/db_coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANALYZE_RECRUITED_DECOYS' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/reproducibility_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_JACCARD_SIMILARITY' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/reproducibility_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PRODUCE_DB_STACKED_BARPLOT' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/reproducibility_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_DB_FAMILY_COVERAGE' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/db_coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GET_SIZE_DISTRIBUTIONS' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/db_coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'INVESTIGATE_MATCHED_ORIGINALS' {
        ext.when = { meta.has_clustering }
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/investigation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_FAMILY_METRICS' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/family_metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANALYZE_SPLITS_MERGES' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/split_merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMPUTE_SCORECARD' {
        publishDir = [
            path: { "${params.outdir}/post/${meta.id}/scorecard" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMPARE_BENCHMARK_RUNS' {
        publishDir = [
            path: { "${params.outdir}/post/comparison" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/post/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
