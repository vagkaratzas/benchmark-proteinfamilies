nextflow_process {

    name "Test Process SAMPLE_INTERPRO"
    script "../main.nf"
    process "SAMPLE_INTERPRO"

    test("interpro_fixture - filtered metadata and hierarchy - sampled families") {

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/filtered_metadata.tsv", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/pre/parsed_hierarchy.txt", checkIfExists: true)
                input[2] = 1
                input[3] = 1
                input[4] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interpro_fixture - filtered metadata and hierarchy - sampled families - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/filtered_metadata.tsv", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/pre/parsed_hierarchy.txt", checkIfExists: true)
                input[2] = 1
                input[3] = 1
                input[4] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
