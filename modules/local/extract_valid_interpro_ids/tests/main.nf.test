nextflow_process {

    name "Test Process EXTRACT_VALID_INTERPRO_IDS"
    script "../main.nf"
    process "EXTRACT_VALID_INTERPRO_IDS"

    test("interpro_fixture - parent child tree - valid interpro ids") {

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/ParentChildTreeFile.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interpro_fixture - parent child tree - valid interpro ids - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/ParentChildTreeFile.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
