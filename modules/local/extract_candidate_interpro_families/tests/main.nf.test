nextflow_process {

    name "Test Process EXTRACT_CANDIDATE_INTERPRO_FAMILIES"
    script "../main.nf"
    process "EXTRACT_CANDIDATE_INTERPRO_FAMILIES"

    test("interpro_fixture - valid ids and xml mapping - candidate families") {

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/interpro_valid_ids.txt", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/pre/interpro.xml.gz", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interpro_fixture - valid ids and xml mapping - candidate families - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/interpro_valid_ids.txt", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/pre/interpro.xml.gz", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
