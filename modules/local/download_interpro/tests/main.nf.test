nextflow_process {

    name "Test Process DOWNLOAD_INTERPRO"
    script "../main.nf"
    process "DOWNLOAD_INTERPRO"

    // Stub only: the script block downloads a remote reference database.
    // Running it for real would fetch tens of GB on every test run.

    test("no input - remote database - interpro hierarchy and mapping - stub") {

        options "-stub"

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
