nextflow_process {

    name "Test Process INVESTIGATE_MATCHED_ORIGINALS"
    script "../main.nf"
    process "INVESTIGATE_MATCHED_ORIGINALS"

    test("universe_fixture - tool msa dir with clustering - matched original diagnostics") {

        when {
            process {
                """
                input[0] = [
                    [ id:'fixture', tool:'tool_mangled_ambiguous' ],
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous", checkIfExists: true),
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous/clustering.tsv", checkIfExists: true)
                ]
                input[1] = file(params.fixture_dir + "/universe/sampled_fasta", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/universe/sampled_metadata.csv", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/universe/id_registry.tsv", checkIfExists: true)
                input[4] = file(params.fixture_dir + "/universe/combined_decoy.faa", checkIfExists: true)
                input[5] = file(params.fixture_dir + "/universe/universe.sha256", checkIfExists: true)
                input[6] = file(params.repo_dir + "/bin/benchmark_ids.py", checkIfExists: true)
                input[7] = file(params.repo_dir + "/bin/post_common.py", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("universe_fixture - tool msa dir with clustering - matched original diagnostics - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'fixture', tool:'tool_mangled_ambiguous' ],
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous", checkIfExists: true),
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous/clustering.tsv", checkIfExists: true)
                ]
                input[1] = file(params.fixture_dir + "/universe/sampled_fasta", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/universe/sampled_metadata.csv", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/universe/id_registry.tsv", checkIfExists: true)
                input[4] = file(params.fixture_dir + "/universe/combined_decoy.faa", checkIfExists: true)
                input[5] = file(params.fixture_dir + "/universe/universe.sha256", checkIfExists: true)
                input[6] = file(params.repo_dir + "/bin/benchmark_ids.py", checkIfExists: true)
                input[7] = file(params.repo_dir + "/bin/post_common.py", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
