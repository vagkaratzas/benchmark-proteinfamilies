nextflow_process {

    name "Test Process ANALYZE_RECRUITED_DECOYS"
    script "../main.nf"
    process "ANALYZE_RECRUITED_DECOYS"

    test("universe_fixture - tool msa dir - decoy stats") {

        when {
            process {
                """
                input[0] = [
                    [ id:'clean', tool:'tool_clean' ],
                    file(params.fixture_dir + "/universe/tool_clean", checkIfExists: true),
                    []
                ]
                input[1] = file(params.fixture_dir + "/universe/id_registry.tsv", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/universe/combined_decoy.faa", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/universe/universe.sha256", checkIfExists: true)
                input[4] = file(params.repo_dir + "/bin/benchmark_ids.py", checkIfExists: true)
                input[5] = file(params.repo_dir + "/bin/post_common.py", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("universe_fixture - tool msa dir - decoy stats - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'clean', tool:'tool_clean' ],
                    file(params.fixture_dir + "/universe/tool_clean", checkIfExists: true),
                    []
                ]
                input[1] = file(params.fixture_dir + "/universe/id_registry.tsv", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/universe/combined_decoy.faa", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/universe/universe.sha256", checkIfExists: true)
                input[4] = file(params.repo_dir + "/bin/benchmark_ids.py", checkIfExists: true)
                input[5] = file(params.repo_dir + "/bin/post_common.py", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
