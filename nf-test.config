config {

    // "." so module tests are discovered next to the code they test
    // (modules/local/<name>/tests/), alongside the workflow tests in tests/.
    testsDir "."
    workDir "/tmp/benchmark-proteinfamilies-nf-test"
    configFile "tests/nextflow.config"
    // The `test` profile caps resources via resourceLimits; without it the process_medium
    // tier in conf/base.config asks for 36.GB and no module test schedules on a laptop.
    // Append a container profile on the CLI with `+`, e.g. --profile +singularity.
    profile "test"

}
