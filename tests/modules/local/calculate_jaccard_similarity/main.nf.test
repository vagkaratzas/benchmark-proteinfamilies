nextflow_process {

    name "Test Process CALCULATE_JACCARD_SIMILARITY"
    script "modules/local/calculate_jaccard_similarity/main.nf"
    process "CALCULATE_JACCARD_SIMILARITY"

    test("universe_fixture - generated families originals registry - jaccard qc") {

        options "-profile test"

        when {
            process {
                """
                input[0] = [
                    [ id:'fixture', tool:'tool_mangled_ambiguous' ],
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous", checkIfExists: true),
                    file(params.fixture_dir + "/universe/tool_mangled_ambiguous/clustering.tsv", checkIfExists: true)
                ]
                input[1] = file(params.fixture_dir + "/universe/sampled_fasta", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/universe/sampled_metadata.csv", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/universe/id_registry.tsv", checkIfExists: true)
                input[4] = file(params.fixture_dir + "/universe/combined_decoy.faa", checkIfExists: true)
                input[5] = file(params.fixture_dir + "/universe/universe.sha256", checkIfExists: true)
                input[6] = file(params.repo_dir + "/bin/benchmark_ids.py", checkIfExists: true)
                input[7] = file(params.repo_dir + "/bin/post_common.py", checkIfExists: true)
                input[8] = 0.1
                input[9] = 0.05
                input[10] = 0.01
                input[11] = ''
                """
            }
        }

        then {
            def rows = path(process.out.edgelist[0][1]).readLines()
            def header = rows[0].split("\t") as List
            def required = [
                "sample",
                "tool",
                "universe_sha256",
                "use_case_basename",
                "original_basename",
                "similarity_score",
                "use_case_layer",
                "db_layer"
            ]
            assertAll(
                { assert process.success },
                { assert header.containsAll(required) },
                { assert rows.size() > 1 },
                { assert rows.drop(1).every { line ->
                    def fields = line.split("\t")
                    def score = fields[header.indexOf("similarity_score")] as BigDecimal
                    score >= 0 && score <= 1
                } },
                { assert path(process.out.qc[0][1]).readLines()[0].split("\t").contains("unmapped_fraction") }
            )
        }

    }

}
