nextflow_process {

    name "Test Process PREPARE_BENCHMARK_FASTA"
    script "modules/local/prepare_benchmark_fasta/main.nf"
    process "PREPARE_BENCHMARK_FASTA"

    test("universe_fixture - sampled metadata db dirs - fasta registry") {

        options "-profile test"

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/universe/sampled_metadata.csv", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/db_metadata/hamap", checkIfExists: true)
                input[2] = file(params.fixture_dir + "/db_metadata/ncbifam", checkIfExists: true)
                input[3] = file(params.fixture_dir + "/db_metadata/panther", checkIfExists: true)
                input[4] = file(params.fixture_dir + "/db_metadata/pfam", checkIfExists: true)
                input[5] = 7
                """
            }
        }

        then {
            def registryLines = path(process.out.registry[0]).readLines()
            def registryHeader = registryLines.find { !it.startsWith("#") }.split("\t") as List
            def expectedColumns = [
                "universe_id",
                "parent_id",
                "source_type",
                "db_layer",
                "family",
                "coords",
                "ungapped_len",
                "seq_sha1"
            ]
            assertAll(
                { assert process.success },
                { assert path(process.out.fasta_folder[0]).toFile().isDirectory() },
                { assert path(process.out.fasta[0]).toFile().isFile() },
                { assert path(process.out.fasta[0]).text.contains(">") },
                { assert path(process.out.registry[0]).toFile().isFile() },
                { assert registryHeader == expectedColumns },
                { assert registryLines.findAll { !it.startsWith("#") }.size() > 1 },
                { assert path(process.out.combined_db_sha256[0]).text.trim() ==~ /[0-9a-f]{64}/ }
            )
        }

    }

}
