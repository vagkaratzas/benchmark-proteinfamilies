nextflow_process {

    name "Test Process SAMPLE_INTERPRO"
    script "modules/local/sample_interpro/main.nf"
    process "SAMPLE_INTERPRO"

    test("tiny_interpro - candidate tsv tree - sampled csv log") {

        options "-profile test"

        when {
            process {
                """
                input[0] = file(params.fixture_dir + "/pre/interpro_candidates.tsv", checkIfExists: true)
                input[1] = file(params.fixture_dir + "/pre/ParentChildTreeFile.txt", checkIfExists: true)
                input[2] = 1
                input[3] = 1
                input[4] = 7
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.metadata[0]).getFileName().toString() == "sampled_metadata.csv" },
                { assert path(process.out.metadata[0]).readLines()[0] == "interpro_id,protein_count,short_name,db,dbkey,name" },
                { assert path(process.out.metadata[0]).readLines().size() == 2 },
                { assert path(process.out.log[0]).getFileName().toString() == "log.txt" },
                { assert path(process.out.log[0]).text.contains("PICKED:") }
            )
        }

    }

}
