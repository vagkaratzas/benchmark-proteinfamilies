nextflow_process {

    name "Test Process EXTRACT_DB_METADATA"
    script "modules/local/extract_db_metadata/main.nf"
    process "EXTRACT_DB_METADATA"

    test("tiny_db_metadata - four db types - metadata tsv") {

        options "-profile test"

        when {
            process {
                """
                input[0] = Channel.of(
                    [[id:'hamap', db_type:'hamap'], file(params.fixture_dir + "/db_metadata/hamap", checkIfExists: true)],
                    [[id:'ncbifam', db_type:'ncbifam'], file(params.fixture_dir + "/db_metadata/ncbifam", checkIfExists: true)],
                    [[id:'panther', db_type:'panther'], file(params.fixture_dir + "/db_metadata/panther", checkIfExists: true)],
                    [[id:'pfam', db_type:'pfam'], file(params.fixture_dir + "/db_metadata/pfam", checkIfExists: true)]
                )
                """
            }
        }

        then {
            def observed = process.out.metadata.collectEntries { tuple ->
                [(tuple[0].id): path(tuple[1]).readLines()]
            }
            assertAll(
                { assert process.success },
                { assert observed.keySet() == ["hamap", "ncbifam", "panther", "pfam"] as Set },
                { assert observed.every { db, lines -> lines[0] == "id\tnum_proteins" } },
                { assert observed.hamap.any { it.startsWith("MF_00001\t2") } },
                { assert observed.ncbifam.any { it.startsWith("NF000001\t2") } },
                { assert observed.ncbifam.any { it.startsWith("TIGR00001\t2") } },
                { assert observed.panther.any { it.startsWith("PTHR00001\t3") } },
                { assert observed.pfam.any { it.startsWith("PF00001\t2") } }
            )
        }

    }

}
