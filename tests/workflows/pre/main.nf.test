nextflow_workflow {

    name "Test Workflow PRE"
    script "workflows/pre.nf"
    workflow "PRE"

    test("test_pre - stub - succeeds") {

        options "-stub --outdir /tmp/nf-test-pre"

        when {
            workflow {
                """
                input[0] = params.fixture_dir + "/pre/ParentChildTreeFile.txt"
                input[1] = params.fixture_dir + "/pre/interpro.xml.gz"
                input[2] = params.fixture_dir + "/db_metadata/hamap"
                input[3] = params.fixture_dir + "/db_metadata/ncbifam"
                input[4] = params.fixture_dir + "/db_metadata/panther"
                input[5] = params.fixture_dir + "/db_metadata/pfam"
                input[6] = params.fixture_dir + "/pre/swissprot.fasta"
                input[7] = false
                input[8] = false
                input[9] = false
                input[10] = false
                input[11] = 1
                input[12] = 1
                input[13] = 2
                input[14] = 1
                """
            }
        }

        then {
            assert workflow.success
        }

    }

    // Skipping databases must not merely leave their families unsampled: the whole DAG has to
    // still build with fewer member databases wired into it.
    test("test_pre - stub - runs with three of four member databases skipped") {

        options "-stub --outdir /tmp/nf-test-pre-skip"

        when {
            workflow {
                """
                input[0] = params.fixture_dir + "/pre/ParentChildTreeFile.txt"
                input[1] = params.fixture_dir + "/pre/interpro.xml.gz"
                input[2] = params.fixture_dir + "/db_metadata/hamap"
                input[3] = params.fixture_dir + "/db_metadata/ncbifam"
                input[4] = params.fixture_dir + "/db_metadata/panther"
                input[5] = params.fixture_dir + "/db_metadata/pfam"
                input[6] = params.fixture_dir + "/pre/swissprot.fasta"
                input[7] = true
                input[8] = true
                input[9] = true
                input[10] = false
                input[11] = 1
                input[12] = 1
                input[13] = 2
                input[14] = 1
                """
            }
        }

        then {
            assert workflow.success
            // Only pfam survived, so exactly one metadata extraction should have run -- proving
            // the skipped databases dropped out of the DAG rather than merely going unsampled.
            assert workflow.trace.succeeded().findAll { it.name.contains('EXTRACT_DB_METADATA') }.size() == 1
        }

    }

}
