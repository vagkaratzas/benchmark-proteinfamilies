nextflow_workflow {

    name "Test Workflow PRE"
    script "workflows/pre.nf"
    workflow "PRE"

    test("test_pre - stub - succeeds") {

        options "-stub -profile test_pre --outdir /tmp/nf-test-pre"

        when {
            workflow {
                """
                input[0] = params.fixture_dir + "/pre/ParentChildTreeFile.txt"
                input[1] = params.fixture_dir + "/pre/interpro.xml.gz"
                input[2] = params.fixture_dir + "/db_metadata/hamap"
                input[3] = params.fixture_dir + "/db_metadata/ncbifam"
                input[4] = params.fixture_dir + "/db_metadata/panther"
                input[5] = params.fixture_dir + "/db_metadata/pfam"
                input[6] = params.fixture_dir + "/pre/swissprot.fasta"
                input[7] = 1
                input[8] = 1
                input[9] = 2
                input[10] = 1
                """
            }
        }

        then {
            assert workflow.success
        }

    }

}
